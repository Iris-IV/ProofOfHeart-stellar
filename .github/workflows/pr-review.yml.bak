# Workflow 2 of 2 — Privileged AI Review (SECRETS GATED BEHIND TRUSTED APPROVAL)
#
# Security model (fixes #472)
# ───────────────────────────
# This workflow is triggered by the `pull_request_review` event, NOT by
# `pull_request_target`.  `pull_request_review` always runs in the context of
# the *base* repository, regardless of whether the PR comes from a fork, so
# it safely has access to repository secrets.
#
# Secrets are only consumed AFTER verifying that:
#   1. The review that triggered this run was **submitted** (not dismissed).
#   2. The reviewer is a member of the repository's CODEOWNER / reviewer team
#      (enforced via the `gh api` team-membership check below).
#   3. The review body contains the exact trigger phrase:
#         /run-auto-review
#      This prevents the Groq call from firing on every random review comment.
#
# No code from the fork is ever executed.  The PR diff arrives as a
# pre-built artifact uploaded by pr-collector.yml (the unprivileged sibling).
#
# Merge safety (fixes #467)
# ─────────────────────────
# The workflow this one replaced merged with `gh pr merge --admin`, which
# bypasses branch protection entirely — that is how a build with duplicate
# error discriminants reached `main` without CI ever passing.  Three things
# stop that from recurring:
#
#   1. `--admin` is gone.  Branch protection is the final authority; if it
#      says no, the merge fails and the job goes red.
#   2. A merge is only *attempted* once every check on the head commit has
#      completed successfully and the PR is conflict-free.  The gate fails
#      closed — pending, missing, or failing checks all mean no merge.
#   3. Every action is pinned to a full commit SHA, so a compromised or
#      retagged upstream action cannot silently gain access to OWNER_PAT.
#
# The model's confidence score gates whether a merge is *proposed*, never
# whether the repository's own rules apply.
#
# References
# ──────────
#   https://securitylab.github.com/research/github-actions-preventing-pwn-requests/
#   https://docs.github.com/en/actions/security-guides/security-hardening-for-github-actions

name: AI PR Review (privileged)

on:
  pull_request_review:
    types: [submitted]

permissions:
  contents: read
  pull-requests: write

jobs:
  review:
    name: Run Groq review and act on PR
    runs-on: ubuntu-latest

    steps:
      # ── Guard: only proceed when a trusted reviewer requests it ───────────
      - name: Validate trigger conditions
        id: gate
        env:
          GH_TOKEN:       ${{ secrets.GITHUB_TOKEN }}
          REVIEWER:       ${{ github.event.review.user.login }}
          REVIEW_STATE:   ${{ github.event.review.state }}
          REVIEW_BODY:    ${{ github.event.review.body }}
          REPO:           ${{ github.repository }}
          REPO_OWNER:     ${{ github.repository_owner }}
          # Comma-separated list of GitHub logins that may trigger the review.
          # If you prefer team-based membership, set TRUSTED_TEAM instead and
          # flip the check below.
          TRUSTED_REVIEWERS: ${{ vars.TRUSTED_REVIEWERS }}
        run: |
          set -euo pipefail

          # 1. The review must be a real submission (not a dismissal).
          if [ "$REVIEW_STATE" != "approved" ] \
              && [ "$REVIEW_STATE" != "changes_requested" ] \
              && [ "$REVIEW_STATE" != "commented" ]; then
            echo "skip=true" >> "$GITHUB_OUTPUT"
            echo "skip_reason=review_state_not_actionable ($REVIEW_STATE)" >> "$GITHUB_OUTPUT"
            exit 0
          fi

          # 2. The review body must contain the exact trigger phrase.
          if ! echo "$REVIEW_BODY" | grep -qF '/run-auto-review'; then
            echo "skip=true" >> "$GITHUB_OUTPUT"
            echo "skip_reason=trigger_phrase_absent" >> "$GITHUB_OUTPUT"
            exit 0
          fi

          # 3. The reviewer must be in the trusted list (TRUSTED_REVIEWERS var)
          #    OR be a repository admin / collaborator with push access.
          TRUSTED=false

          if [ -n "${TRUSTED_REVIEWERS:-}" ]; then
            # TRUSTED_REVIEWERS is a comma-separated list stored as a repo var.
            IFS=',' read -ra TRUSTED_LIST <<< "$TRUSTED_REVIEWERS"
            for LOGIN in "${TRUSTED_LIST[@]}"; do
              TRIMMED=$(echo "$LOGIN" | tr -d '[:space:]')
              if [ "$REVIEWER" = "$TRIMMED" ]; then
                TRUSTED=true
                break
              fi
            done
          fi

          # Fallback: check if the reviewer has at least write (push) access.
          if [ "$TRUSTED" = "false" ]; then
            PERM=$(gh api \
              "repos/$REPO/collaborators/$REVIEWER/permission" \
              --jq '.permission' 2>/dev/null || echo "none")
            if [ "$PERM" = "admin" ] || [ "$PERM" = "write" ]; then
              TRUSTED=true
            fi
          fi

          if [ "$TRUSTED" = "false" ]; then
            echo "skip=true" >> "$GITHUB_OUTPUT"
            echo "skip_reason=reviewer_not_trusted ($REVIEWER)" >> "$GITHUB_OUTPUT"
            exit 0
          fi

          echo "skip=false"             >> "$GITHUB_OUTPUT"
          echo "skip_reason=none"       >> "$GITHUB_OUTPUT"
          echo "reviewer=$REVIEWER"     >> "$GITHUB_OUTPUT"

      # ── Skip the rest if gate conditions not met ──────────────────────────
      - name: Log skip reason (informational)
        if: steps.gate.outputs.skip == 'true'
        run: |
          echo "Skipping privileged review: ${{ steps.gate.outputs.skip_reason }}"

      # ── Download the artifact produced by pr-collector.yml ────────────────
      # Fix: actions/download-artifact@v4 only searches the *current* run.
      # The artifact was uploaded by a separate pull_request run (pr-collector),
      # so we use dawidd6/action-download-artifact which searches across runs.
      - name: Download PR artifact
        if: steps.gate.outputs.skip != 'true'
        uses: dawidd6/action-download-artifact@bf251b5aa9c2f7eeb574a96ee720e24f801b7c11 # v6
        with:
          github_token: ${{ secrets.GITHUB_TOKEN }}
          name: pr-${{ github.event.pull_request.number }}
          path: /tmp/pr-artifact
          search_artifacts: true
          if_no_artifact_found: fail

      # ── Load metadata and handle empty-diff case ──────────────────────────
      - name: Load metadata
        if: steps.gate.outputs.skip != 'true'
        id: meta
        run: |
          set -euo pipefail

          META=/tmp/pr-artifact/pr-meta.json

          echo "pr_number=$(jq -r '.pr_number'        "$META")" >> "$GITHUB_OUTPUT"
          echo "pr_title=$(jq  -r '.pr_title'         "$META")" >> "$GITHUB_OUTPUT"
          echo "pr_author=$(jq -r '.pr_author'        "$META")" >> "$GITHUB_OUTPUT"
          echo "files=$(jq     -r '.files'            "$META")" >> "$GITHUB_OUTPUT"
          echo "adds=$(jq      -r '.adds'             "$META")" >> "$GITHUB_OUTPUT"
          echo "dels=$(jq      -r '.dels'             "$META")" >> "$GITHUB_OUTPUT"
          echo "has_issue=$(jq -r '.has_issue'        "$META")" >> "$GITHUB_OUTPUT"
          echo "auto_fraud=$(jq -r '.auto_fraud'      "$META")" >> "$GITHUB_OUTPUT"
          echo "fraud_type=$(jq -r '.fraud_type'      "$META")" >> "$GITHUB_OUTPUT"

          {
            echo "pr_body<<GHA_DELIM"
            jq -r '.pr_body' "$META"
            echo "GHA_DELIM"
          } >> "$GITHUB_OUTPUT"

      # ── Handle pre-flight detected empty PR ───────────────────────────────
      - name: Handle empty-diff PR (auto-close)
        if: |
          steps.gate.outputs.skip != 'true'
          && steps.meta.outputs.auto_fraud == 'true'
        env:
          GH_TOKEN:  ${{ secrets.OWNER_PAT }}
          PR_NUM:    ${{ steps.meta.outputs.pr_number }}
          PR_AUTHOR: ${{ steps.meta.outputs.pr_author }}
        run: |
          set -euo pipefail

          PAT_USER=$(gh api user --jq '.login' 2>/dev/null || echo "")
          BODY=$(printf '%s\n' \
            "This PR has an empty or whitespace-only diff — no real code changes detected." \
            "" \
            "If you intended to push code, please commit it. Closing automatically; reopen once you have actual changes.")

          if [ "$PR_AUTHOR" = "$PAT_USER" ]; then
            gh pr comment "$PR_NUM" --body "$BODY"
          else
            gh pr review "$PR_NUM" --request-changes --body "$BODY" \
              || gh pr comment "$PR_NUM" --body "$BODY"
          fi

          gh pr close "$PR_NUM" \
            --comment "Closed: empty diff. Reopen with real changes." || true

      # ── Groq fraud-detection review ───────────────────────────────────────
      - name: Lenient fraud-detection review (Groq)
        if: |
          steps.gate.outputs.skip != 'true'
          && steps.meta.outputs.auto_fraud != 'true'
        id: review
        env:
          # GROQ_API_KEY is only injected here, in the privileged workflow,
          # after the trusted-reviewer gate has been passed.
          GROQ_API_KEY: ${{ secrets.GROQ_API_KEY }}
          PR_TITLE:  ${{ steps.meta.outputs.pr_title }}
          PR_AUTHOR: ${{ steps.meta.outputs.pr_author }}
          PR_BODY:   ${{ steps.meta.outputs.pr_body }}
          PR_FILES:  ${{ steps.meta.outputs.files }}
          PR_ADDS:   ${{ steps.meta.outputs.adds }}
          PR_DELS:   ${{ steps.meta.outputs.dels }}
          HAS_ISSUE: ${{ steps.meta.outputs.has_issue }}
        run: |
          set -euo pipefail

          SYSTEM_PROMPT=$(cat <<'SYSTEM_EOF'
          You are a code reviewer for the ProofOfHeart open-source project on GitHub.
          Your role is to evaluate pull requests for genuine contribution quality.

          ## Default behaviour: APPROVE real work

          IGNORE all of: code style, formatting, naming conventions, missing tests,
          untyped code, imperfect patterns, unhandled edge cases, performance,
          accessibility, missing comments, missing documentation, ugly code,
          "not idiomatic" patterns, suggestions for improvement, partial
          implementations, work-in-progress code that compiles.

          A PR with real code changes that plausibly relate to the title or linked
          issue → APPROVE. Do not nitpick. Do not request style fixes. Do not worry
          about quality. Approve.

          Examples that should APPROVE:
          - Bad style but real changes → APPROVE
          - Solves only part of the issue → APPROVE
          - Has typos in code or description → APPROVE
          - Could be done more elegantly → APPROVE
          - Missing tests → APPROVE
          - Wrong-looking but plausible attempt → APPROVE
          - Hardcoded values, magic numbers → APPROVE
          - No error handling → APPROVE

          ## Exception: catch SCAM / FRAUD

          You exist for ONE purpose besides approving: catch contributors who are
          GAMING the contribution credit system without doing real work. Flag fraud
          ONLY when you have concrete evidence in the diff itself.

          Fraud categories (FLAG_FRAUD):

          1. empty: diff is whitespace-only, formatting-only, import-reordering only,
             or comment-only changes passed off as substantive feature work.
          2. unrelated: the diff has no plausible connection to the PR title /
             description / linked issue (e.g. PR titled "fix login bug" but the diff
             only changes a colour or unrelated README section).
          3. ai_slop: obvious AI-generated boilerplate that adds dead code (functions
             never called, types never used, components never rendered, files never
             imported) with no actual problem being solved in the existing codebase.
          4. copy_paste: code copied verbatim from another file in the same repo
             with trivial renames, presenting duplicated logic as new work.
          5. revert_repackage: the diff reverts another contributor's prior commits
             and presents the reverted state as the contributor's own change.
          6. claim_mismatch: PR description claims to implement X (e.g. "adds JWT
             auth") but the diff clearly does NOT implement X (e.g. only edits a
             string literal). The discrepancy must be objectively obvious from the
             diff, not a subjective judgement about completeness.
          7. security: exposed secrets / API keys / private keys / credentials
             hardcoded in the diff, or obviously destructive code (rm -rf $HOME,
             DROP TABLE in production paths, leaking PII to logs).

          ## Critical decision rule

          If you are NOT highly certain that fraud is happening, APPROVE.
          False-positive fraud accusations damage intern morale and trust.
          Only FLAG_FRAUD when the evidence is staring you in the face.

          "Low effort" is NOT fraud. "Could be better" is NOT fraud.
          "Doesn't fully solve the issue" is NOT fraud. "Code smells" is NOT fraud.

          Your confidence on FLAG_FRAUD must reflect this: if you are even slightly
          uncertain, either APPROVE or set FLAG_FRAUD confidence below 0.7.

          ## Output

          Respond with a SINGLE JSON object only. No preamble, no markdown fences,
          no explanation outside the JSON.

          The "summary" field is what gets posted to the PR as your review comment.
          Keep it natural, friendly, and conversational — under 150 words, addressed
          to the contributor. Do NOT include any meta-commentary about confidence,
          fraud type, or that you are an automated reviewer in the summary text.

          Schema:
          {
            "decision": "APPROVE" | "FLAG_FRAUD",
            "confidence": <number between 0 and 1, where 1 = certain>,
            "fraud_type": "none" | "empty" | "unrelated" | "ai_slop" | "copy_paste" | "revert_repackage" | "claim_mismatch" | "security",
            "evidence": <string — for FLAG_FRAUD, cite specific files/lines/patterns from the diff that prove the fraud; for APPROVE, name one real change you observed>,
            "summary": <string under 150 words, friendly tone, addressed to the contributor>
          }
          SYSTEM_EOF
          )

          PAYLOAD=$(jq -n \
            --arg system  "$SYSTEM_PROMPT" \
            --arg title   "$PR_TITLE" \
            --arg author  "$PR_AUTHOR" \
            --arg pr_body "$PR_BODY" \
            --arg files   "$PR_FILES" \
            --arg adds    "$PR_ADDS" \
            --arg dels    "$PR_DELS" \
            --arg has_iss "$HAS_ISSUE" \
            --rawfile diff    /tmp/pr-artifact/pr-diff-truncated.txt \
            --rawfile issues  /tmp/pr-artifact/issues-context.txt \
            '{
              model: "openai/gpt-oss-120b",
              messages: [
                { role: "system", content: $system },
                { role: "user",   content: (
                    "## PR metadata\n\n" +
                    "Title: "         + $title  + "\n" +
                    "Author: "        + $author + "\n" +
                    "Files changed: " + $files  + "\n" +
                    "Additions: "     + $adds   + "\n" +
                    "Deletions: "     + $dels   + "\n" +
                    "Has linked issue: " + $has_iss + "\n\n" +
                    "## PR description\n\n" + $pr_body + "\n\n" +
                    "## Linked issue(s) full content\n\n" + $issues + "\n\n" +
                    "## Diff (first 3000 lines)\n\n```diff\n" + $diff + "\n```\n\n" +
                    "Now produce the JSON review object."
                ) }
              ],
              max_completion_tokens: 4096,
              temperature: 0.1,
              response_format: { type: "json_object" },
              reasoning_effort: "medium"
            }')

          RESPONSE=$(curl -s --max-time 180 https://api.groq.com/openai/v1/chat/completions \
            -H "Content-Type: application/json" \
            -H "Authorization: Bearer $GROQ_API_KEY" \
            -d "$PAYLOAD")

          echo "Response top-level keys: $(echo "$RESPONSE" | jq -r 'keys | join(", ")' 2>/dev/null || echo '<unparseable>')"

          API_ERROR=$(echo   "$RESPONSE" | jq -r '.error.message // ""'            2>/dev/null || echo "")
          REVIEW_JSON=$(echo "$RESPONSE" | jq -r '.choices[0].message.content // ""' 2>/dev/null || echo "")

          DECISION="UNKNOWN"
          CONFIDENCE="0"
          FRAUD_TYPE="none"
          EVIDENCE=""
          MODEL_SUMMARY=""

          if [ -n "$API_ERROR" ] && [ "$API_ERROR" != "null" ]; then
            echo "Groq API error: $API_ERROR"
            MODEL_SUMMARY="Auto-review failed (API error). Leaving PR for human review."
          elif [ -z "$REVIEW_JSON" ] || [ "$REVIEW_JSON" = "null" ]; then
            echo "Empty model response"
            MODEL_SUMMARY="Auto-review returned an empty response. Leaving PR for human review."
          elif ! echo "$REVIEW_JSON" | jq empty 2>/dev/null; then
            echo "Model output is not valid JSON. Raw: $REVIEW_JSON"
            MODEL_SUMMARY="Auto-review returned malformed output. Leaving PR for human review."
          else
            DECISION=$(echo    "$REVIEW_JSON" | jq -r '.decision   // "UNKNOWN"')
            CONFIDENCE=$(echo  "$REVIEW_JSON" | jq -r '.confidence // 0')
            FRAUD_TYPE=$(echo  "$REVIEW_JSON" | jq -r '.fraud_type // "none"')
            EVIDENCE=$(echo    "$REVIEW_JSON" | jq -r '.evidence   // ""')
            MODEL_SUMMARY=$(echo "$REVIEW_JSON" | jq -r '.summary  // ""')

            if [ "$DECISION" != "APPROVE" ] && [ "$DECISION" != "FLAG_FRAUD" ]; then
              echo "Unrecognised decision value: $DECISION — failing closed"
              DECISION="UNKNOWN"
              MODEL_SUMMARY="Auto-review returned an unrecognised decision. Leaving PR for human review."
            fi
          fi

          echo "::group::Auto-review details (run-only, not posted)"
          echo "Decision:   $DECISION"
          echo "Confidence: $CONFIDENCE"
          echo "Fraud type: $FRAUD_TYPE"
          echo "Evidence:   $EVIDENCE"
          echo "::endgroup::"

          if [ -z "$MODEL_SUMMARY" ]; then
            MODEL_SUMMARY="Looks good."
          fi

          echo "decision=$DECISION"       >> "$GITHUB_OUTPUT"
          echo "confidence=$CONFIDENCE"   >> "$GITHUB_OUTPUT"
          echo "fraud_type=$FRAUD_TYPE"   >> "$GITHUB_OUTPUT"
          {
            echo "body<<REVIEW_EOF"
            echo "$MODEL_SUMMARY"
            echo "REVIEW_EOF"
          } >> "$GITHUB_OUTPUT"

      # ── Submit review and act on decision ─────────────────────────────────
      - name: Submit review and act on decision
        if: |
          steps.gate.outputs.skip != 'true'
          && steps.meta.outputs.auto_fraud != 'true'
        id: act
        env:
          # OWNER_PAT is only injected here, after the trusted-reviewer gate.
          GH_TOKEN:   ${{ secrets.OWNER_PAT }}
          PR_NUM:     ${{ steps.meta.outputs.pr_number }}
          PR_AUTHOR:  ${{ steps.meta.outputs.pr_author }}
          DECISION:   ${{ steps.review.outputs.decision }}
          CONFIDENCE: ${{ steps.review.outputs.confidence }}
          FRAUD_TYPE: ${{ steps.review.outputs.fraud_type }}
          BODY:       ${{ steps.review.outputs.body }}
        run: |
          set -euo pipefail

          PAT_USER=$(gh api user --jq '.login' 2>/dev/null || echo "")
          IS_SELF_PR="false"
          [ "$PR_AUTHOR" = "$PAT_USER" ] && IS_SELF_PR="true"

          MERGE_OK=$(awk -v c="$CONFIDENCE" 'BEGIN { print (c+0 >= 0.7)  ? "true" : "false" }')
          CLOSE_OK=$(awk -v c="$CONFIDENCE" 'BEGIN { print (c+0 >= 0.85) ? "true" : "false" }')

          echo "merge_ok=$MERGE_OK" >> "$GITHUB_OUTPUT"
          echo "close_ok=$CLOSE_OK" >> "$GITHUB_OUTPUT"

          [ -z "$BODY" ] && BODY="Looks good."

          case "$DECISION" in
            APPROVE)
              if [ "$IS_SELF_PR" = "true" ]; then
                gh pr comment "$PR_NUM" --body "$BODY"
              else
                gh pr review "$PR_NUM" --approve --body "$BODY"
              fi
              ;;

            FLAG_FRAUD)
              if [ "$IS_SELF_PR" = "true" ]; then
                gh pr comment "$PR_NUM" --body "$BODY"
              else
                gh pr review "$PR_NUM" --request-changes --body "$BODY"
              fi

              if [ "$CLOSE_OK" = "true" ]; then
                gh pr close "$PR_NUM" \
                  --comment "Closed: $FRAUD_TYPE. Reopen with real changes if this was a mistake." \
                  || true
              fi
              ;;

            *)
              gh pr comment "$PR_NUM" --body "$BODY"
              ;;
          esac

      # ── Require CI green before any merge is attempted (fixes #467) ───────
      #
      # The previous revision of this workflow merged with `gh pr merge
      # --admin`, which bypasses branch protection outright — that is how the
      # broken build introducing duplicate error discriminants reached `main`.
      # `--admin` is gone; GitHub's own branch protection is now the final
      # authority on whether a merge is allowed.
      #
      # This step is belt-and-braces on top of that: it refuses to even attempt
      # the merge unless every check on the head commit has completed
      # successfully and the PR is free of conflicts, so a blocked PR produces
      # a readable comment instead of an opaque API error.
      - name: Verify CI is green
        if: |
          steps.gate.outputs.skip != 'true'
          && steps.meta.outputs.auto_fraud != 'true'
          && steps.review.outputs.decision == 'APPROVE'
          && steps.act.outputs.merge_ok == 'true'
        id: ci
        env:
          GH_TOKEN:      ${{ secrets.GITHUB_TOKEN }}
          PR_NUM:        ${{ steps.meta.outputs.pr_number }}
          REPO:          ${{ github.repository }}
          # This workflow's own check run appears in the PR's rollup. Excluding
          # it by name keeps the gate from waiting on itself forever.
          SELF_WORKFLOW: ${{ github.workflow }}
        run: |
          set -euo pipefail

          # Checks are usually finished by the time a reviewer types the
          # trigger phrase, but allow a bounded wait for stragglers. Fails
          # closed: if they have not settled within the window, no merge.
          ATTEMPTS=10
          SLEEP=30

          for i in $(seq 1 "$ATTEMPTS"); do
            PR_JSON=$(gh pr view "$PR_NUM" --repo "$REPO" \
              --json statusCheckRollup,mergeable)

            # statusCheckRollup mixes CheckRun objects (status/conclusion) with
            # commit StatusContext objects (state); handle both shapes. The
            # rollup is null when no checks have been reported at all.
            CHECKS=$(echo "$PR_JSON" | jq --arg self "$SELF_WORKFLOW" \
              '[ (.statusCheckRollup // [])[]
                 | select((.workflowName // "") != $self) ]')

            TOTAL=$(echo "$CHECKS" | jq 'length')
            PENDING=$(echo "$CHECKS" | jq '[ .[] | select(
                (((.status // "COMPLETED") | ascii_upcase) != "COMPLETED")
                or (((.state // "SUCCESS") | ascii_upcase) == "PENDING")
              ) ] | length')
            FAILED=$(echo "$CHECKS" | jq '[ .[] | select(
                (((.conclusion // "") | ascii_upcase)
                   | IN("FAILURE","TIMED_OUT","CANCELLED","ACTION_REQUIRED","STARTUP_FAILURE"))
                or (((.state // "") | ascii_upcase) | IN("FAILURE","ERROR"))
              ) ] | length')

            MERGEABLE=$(echo "$PR_JSON" | jq -r '.mergeable // "UNKNOWN"')

            echo "attempt $i/$ATTEMPTS — checks: $TOTAL total, $PENDING pending, $FAILED failed; mergeable=$MERGEABLE"

            if [ "$PENDING" -eq 0 ] && [ "$MERGEABLE" != "UNKNOWN" ]; then
              break
            fi

            if [ "$i" -lt "$ATTEMPTS" ]; then
              sleep "$SLEEP"
            fi
          done

          REASON=""
          if [ "$TOTAL" -eq 0 ]; then
            REASON="no status checks reported on the head commit"
          elif [ "$PENDING" -ne 0 ]; then
            REASON="$PENDING check(s) still running after $((ATTEMPTS * SLEEP))s"
          elif [ "$FAILED" -ne 0 ]; then
            REASON="$FAILED check(s) failing"
          elif [ "$MERGEABLE" != "MERGEABLE" ]; then
            REASON="pull request is not mergeable (state: $MERGEABLE)"
          fi

          if [ -n "$REASON" ]; then
            echo "green=false"          >> "$GITHUB_OUTPUT"
            echo "reason=$REASON"       >> "$GITHUB_OUTPUT"
            echo "CI gate not satisfied: $REASON"
          else
            echo "green=true"           >> "$GITHUB_OUTPUT"
            echo "reason=none"          >> "$GITHUB_OUTPUT"
          fi

      # ── Auto-merge approved PRs at high confidence ────────────────────────
      #
      # No `--admin`. If branch protection requires approvals, up-to-date
      # branches, or checks this job did not inspect, the merge is rejected by
      # GitHub and this step fails loudly — which is the intended behaviour.
      - name: Auto-merge approved PRs at high confidence
        if: |
          steps.gate.outputs.skip != 'true'
          && steps.meta.outputs.auto_fraud != 'true'
          && steps.review.outputs.decision == 'APPROVE'
          && steps.act.outputs.merge_ok == 'true'
          && steps.ci.outputs.green == 'true'
        env:
          GH_TOKEN: ${{ secrets.OWNER_PAT }}
          PR_NUM:   ${{ steps.meta.outputs.pr_number }}
          PR_TITLE: ${{ steps.meta.outputs.pr_title }}
        run: |
          set -euo pipefail

          MERGE_BODY=$(gh pr view "$PR_NUM" --json commits \
            --jq '[.commits[].messageBody] | join("\n")' \
            | grep -viE 'co-authored-by:.*(claude|qwen|copilot|github-actions|bot|\[bot\]|gpt|openai|anthropic)' \
            | sed '/^$/N;/^\n$/d' \
            || true)

          gh pr merge "$PR_NUM" \
            --squash \
            --subject "$PR_TITLE" \
            --body    "$MERGE_BODY"

      # ── Explain a skipped merge instead of failing silently ───────────────
      - name: Report why the merge was skipped
        if: |
          steps.gate.outputs.skip != 'true'
          && steps.meta.outputs.auto_fraud != 'true'
          && steps.review.outputs.decision == 'APPROVE'
          && steps.act.outputs.merge_ok == 'true'
          && steps.ci.outputs.green != 'true'
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          PR_NUM:   ${{ steps.meta.outputs.pr_number }}
          REASON:   ${{ steps.ci.outputs.reason }}
        run: |
          set -euo pipefail

          gh pr comment "$PR_NUM" --body "$(printf '%s\n\n%s' \
            "Auto-merge skipped: $REASON." \
            "The review above still stands — this PR just needs a green build (or a maintainer merge) before it can land.")"
